10 REM TEST 40 - COMBINED DATA READ WHILE RANDOMIZE CLEAR
20 PRINT "=== TEST 40: COMBINED FEATURES ==="
30 RANDOMIZE 7
40 DATA 3, 1, 4, 1, 5, 9, 2, 6
50 LET S = 0
60 LET I = 1
70 WHILE I <= 8
80 READ V
90 LET S = S + V
100 LET I = I + 1
110 WEND
120 PRINT S
130 RESTORE
140 LET I = 1
150 WHILE I <= 8
160 READ V
170 PRINT V;
180 LET I = I + 1
190 WEND
200 PRINT
210 PRINT S
220 CLEAR
230 PRINT S
240 PRINT "EXPECTED: 31  3 1 4 1 5 9 2 6  31  0"
250 END
