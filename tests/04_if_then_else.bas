10 REM TEST 04 - IF THEN ELSE
20 PRINT "=== TEST 04: IF THEN ELSE ==="
30 LET X = 5
40 IF X > 3 THEN PRINT "X GT 3"
50 IF X < 3 THEN PRINT "SHOULD NOT PRINT"
60 IF X = 5 THEN PRINT "X EQ 5"
70 IF X <> 5 THEN PRINT "SHOULD NOT PRINT"
80 IF X >= 5 THEN PRINT "X GE 5"
90 IF X <= 5 THEN PRINT "X LE 5"
100 IF X > 10 THEN PRINT "NO" ELSE PRINT "X NOT GT 10"
110 LET A$ = "YES"
120 IF A$ = "YES" THEN PRINT "STRING EQ OK"
130 PRINT "EXPECTED: X GT 3  X EQ 5  X GE 5  X LE 5  X NOT GT 10  STRING EQ OK"
140 END
