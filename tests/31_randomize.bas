10 REM TEST 31 - RANDOMIZE SEED REPRODUCIBILITY
20 PRINT "=== TEST 31: RANDOMIZE ==="
30 RANDOMIZE 42
40 LET R1 = INT(RND(1) * 10000)
50 LET R2 = INT(RND(1) * 10000)
60 LET R3 = INT(RND(1) * 10000)
70 RANDOMIZE 42
80 LET S1 = INT(RND(1) * 10000)
90 LET S2 = INT(RND(1) * 10000)
100 LET S3 = INT(RND(1) * 10000)
110 IF R1 = S1 AND R2 = S2 AND R3 = S3 THEN PRINT "SAME SEED SAME SEQUENCE"
120 IF R1 <> S1 OR R2 <> S2 OR R3 <> S3 THEN PRINT "FAIL - SEED MISMATCH"
130 LET C = 0
140 FOR I = 1 TO 500
150 LET R = RND(1)
160 IF R >= 0 AND R < 1 THEN LET C = C + 1
170 NEXT I
180 IF C = 500 THEN PRINT "ALL VALUES IN RANGE"
190 PRINT "EXPECTED: SAME SEED SAME SEQUENCE  ALL VALUES IN RANGE"
200 END
