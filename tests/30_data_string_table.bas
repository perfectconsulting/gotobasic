10 REM TEST 30 - DATA STRING TABLE WITH RESTORE REREAD
20 PRINT "=== TEST 30: DATA STRING TABLE ==="
30 DATA "MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN"
40 LET N = 3
50 FOR I = 1 TO N
60 READ D$
70 NEXT I
80 PRINT D$
90 RESTORE
100 FOR I = 1 TO 7
110 READ D$
120 PRINT D$; " ";
130 NEXT I
140 PRINT
150 PRINT "EXPECTED: WED  MON TUE WED THU FRI SAT SUN"
160 END
