10 REM TEST 29 - DATA READ LOOP AND RESTORE RE-READ
20 PRINT "=== TEST 29: DATA LOOP AND RESTORE ==="
30 DATA 5, 10, 15, 20, 25
40 FOR I = 1 TO 5
50 READ V
60 PRINT V;
70 NEXT I
80 PRINT
90 RESTORE
100 LET S = 0
110 FOR I = 1 TO 5
120 READ V
130 LET S = S + V
140 NEXT I
150 PRINT S
160 PRINT "EXPECTED: 5 10 15 20 25  75"
170 END
