10 REM TEST 22 - MATRIX MULTIPLY
20 PRINT "=== TEST 22: 3X3 MATRIX MULTIPLY ==="
30 DIM A(3, 3), B(3, 3), C(3, 3)
40 FOR I = 1 TO 3
50 FOR J = 1 TO 3
60 IF I = J THEN LET A(I, J) = 1 ELSE LET A(I, J) = 0
70 LET B(I, J) = I * 3 + J - 3
80 NEXT J
90 NEXT I
100 FOR I = 1 TO 3
110 FOR J = 1 TO 3
120 LET C(I, J) = 0
130 FOR K = 1 TO 3
140 LET C(I, J) = C(I, J) + A(I, K) * B(K, J)
150 NEXT K
160 NEXT J
170 NEXT I
180 FOR I = 1 TO 3
190 FOR J = 1 TO 3
200 PRINT C(I, J);
210 NEXT J
220 PRINT
230 NEXT I
240 PRINT "EXPECTED (I*A=B):"
250 PRINT "1 2 3"
260 PRINT "4 5 6"
270 PRINT "7 8 9"
280 END
